{
  "manifest_version": 3,
  "name": "ASTP Browser Intake",
  "version": "0.1.0",
  "description": "Capture the current authenticated page for local ASTP program intake.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "action": {
    "default_title": "Import current page into ASTP",
    "default_popup": "popup.html"
  }
}
